Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# казахская версия сайта — своя страница «не найдено» на казахском (build.py: build_404)
<If "%{REQUEST_URI} =~ m#^/kz/#">
  ErrorDocument 404 /kz/404.html
</If>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Один адрес для поисковиков: http, www и другие домены (alfimov.pro) → https://alfimov.kz
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^alfimov\.kz$ [NC]
  RewriteRule ^ https://alfimov.kz%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Блог и админка — PHP на хостинге (static/_blog/, static/admin/)
  # Служебные файлы блога снаружи не открываются: 404 через rewrite, а не запрет доступа (Require) —
  # отказы доступа попадают в лог ошибок, и fail2ban хостинга банит IP (так забанило нас самих).
  RewriteCond %{THE_REQUEST} \s/+_blog/ [NC]
  RewriteRule ^ - [R=404,L]
  # то же для закодированных адресов (/%5Fblog/…): проверяем уже раскодированный путь, но только у запроса снаружи —
  # внутренние переходы на _blog/router.php (правила ниже) идут с REDIRECT_STATUS и не задеваются
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^_blog/ - [R=404,L]
  # Служебные файлы api/_*.php (библиотеки, _lp-clients.json) напрямую не открываются
  RewriteRule ^api/_ - [R=404,L]
  RewriteRule ^blog$ /blog/ [L,R=301]
  RewriteRule ^blog/([a-z0-9-]+)$ /blog/$1/ [L,R=301]
  RewriteRule ^$ _blog/router.php?route=home [L]
  RewriteRule ^sitemap\.xml$ _blog/router.php?route=sitemap [L]
  RewriteRule ^llms\.txt$ _blog/router.php?route=llms [L]
  RewriteRule ^llms-full\.txt$ _blog/router.php?route=llms-full [L]
  RewriteRule ^blog/$ _blog/router.php?route=index [L]
  RewriteRule ^blog/media/([A-Za-z0-9._-]+)$ _blog/router.php?route=media&f=$1 [L]
  # Статьи про цену ведения объединены в одну (2026-11-05) — старые адреса 301 на объединённую, чтобы не терять
  # ссылки и позиции в Google
  RewriteRule ^blog/vedenie-instagram-cena-mesyac/?$ /blog/skolko-stoit-vedenie-instagram/ [L,R=301]
  RewriteRule ^blog/vedenie-socsetej-stoimost/?$ /blog/skolko-stoit-vedenie-instagram/ [L,R=301]
  RewriteRule ^blog/skolko-stoit-target/?$ /blog/stoimost-targetirovannoj-reklamy-kazahstan/ [L,R=301]
  RewriteRule ^blog/([a-z0-9-]+)/$ _blog/router.php?route=article&slug=$1 [L]
  # Блог на казахском (static/_blog/lib.php: blog_path('kk')) — та же обложка PHP, без adres media: картинки общие
  RewriteRule ^kz/blog$ /kz/blog/ [L,R=301]
  RewriteRule ^kz/blog/([a-z0-9-]+)$ /kz/blog/$1/ [L,R=301]
  RewriteRule ^kz/blog/$ _blog/router.php?route=index&lang=kk [L]
  RewriteRule ^kz/blog/([a-z0-9-]+)/$ _blog/router.php?route=article&slug=$1&lang=kk [L]
  RewriteRule ^admin$ /admin/ [L,R=301]
  RewriteRule ^admin/$ admin/index.php [L]
  RewriteRule ^admin/(api|preview)/(.*)$ admin/api.php?r=$1/$2 [L,QSA]

  # Рекламные страницы: старая страница брендирования Guestory → оснащение (брендирование — бонус к заказу)
  RewriteRule ^lp/guestory/branding/?$ /lp/guestory/osnashenie/ [L,R=301]

  # Страницы без слеша на конце → со слешем
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # Адрес из одного слова, которого нет (ИИ в статьях ссылался на «/slug/» без «/blog/»): если есть похожая
  # статья — 301 на неё, иначе страница «не найдено» (engine: _blog/router.php route=guess)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ _blog/router.php?route=guess&slug=$1 [L]
</IfModule>

<IfModule mod_setenvif.c>
  # CSP enforced только на чисто статических страницах (build.py: page(), без единого PHP-роута на них);
  # остальное (переменная CSP_SOFT) — на Report-Only.
  # ВАЖНО: Request_URI тут иногда отражает путь ПОСЛЕ внутреннего rewrite (не исходный /, /blog/…), а не
  # до — на проде (Plesk) так и оказалось для "/" и "/blog/" (оба уходят в _blog/router.php), хотя локально
  # (Apache 2.4.67 на Mac) Request_URI всегда оставался исходным. Поэтому ловим обе формы: и исходный путь
  # снаружи (/admin/, /api/, /lp/ — эти не редиректятся), и файл, на который реально рвёрайтится (.htaccess
  # выше: ^$, blog/…, kz/blog/… → _blog/router.php; admin/$ и admin/(api|preview)/… → admin/index.php и api.php).
  SetEnvIf Request_URI "^/(blog|kz/blog|admin|api|lp)(/|$)" CSP_SOFT
  SetEnvIf Request_URI "^/$" CSP_SOFT
  SetEnvIf Request_URI "_blog/router\.php" CSP_SOFT
  SetEnvIf Request_URI "admin/(index|api)\.php" CSP_SOFT
  # Проверено диагностикой 05.11.2026: на проде Request_URI для ЛЮБОГО маршрута _blog/router.php (route=home
  # И route=index/article — это один и тот же файл) приходит как "/_blog/router.php" БЕЗ query string вообще
  # (Query_String пуст) — значит отличить home от блога через .htaccess в принципе нельзя, только из самого
  # PHP (своя логика в router.php/send_html(), и тогда убрать отсюда блокировку этого маршрута целиком, чтобы
  # Apache «Header always set» не перетирал то, что выставит PHP). Не делал — третья правка CSP за сессию,
  # решил не рисковать проды без дополнительного тестирования. Главная остаётся на Report-Only.
</IfModule>
<IfModule mod_headers.c>
  # X-Content-Type-Options: хостинг (Plesk/nginx) уже шлёт nosniff сам — свою строку убрали, была задвоена.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Инлайн-скрипты и инлайн-стили исключены (style.css: .tw-i-N/.flow-i-N/.flow-n-N) либо разрешены по
  # точному sha256-хэшу содержимого (build.py: csp_hash → 'sha256-3n6idvuHpScgpn9nLbP70cjHcC5/W7R1cJdbhfWXvHw=' 'sha256-5r3QhUpwYLkeKvYr5b3YUOWDxryAkVfcS7XaL5yyINY=' 'sha256-D6Edc1C05AN/e3SL1C9KYUrxrCwFcB/PY34Igck4Z7U=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-EQb2/p4Uv56vxKorR2KKQXvIBeDvLOGSDsbe9o76yTE=' 'sha256-FnTfH2386+agLICky+4R3CPW6nfBHxasDyQ1I2vxGqo=' 'sha256-J651B0aohC6ucUYprXjBhr6EizJCG7rPSkGYBwKCRPQ=' 'sha256-JAnWNJVFA23Uc3eTUV7C8uPaRsnk3sbCLz3lhpMBPnQ=' 'sha256-JCje1nHdPymhaxO3CtqCTR57lg0iaab2IzvNLNIakZ0=' 'sha256-Jr/UwlHcjeEhmCMt4wAEiK8UCUuru5P/MqAno4c06oU=' 'sha256-L52zYt8BQ5vw7EJPYZwPlkPcWUPLrYHAuLXw9i+sMb4=' 'sha256-LKGFOVif1Qw4XzXusEBkt9D1DCVtwHYRoKk9g2Me8bU=' 'sha256-MBfFgv0Qg6xep+Q8Cc0AwMIyVoeJIqz0QUjgIaA1tXU=' 'sha256-S7bBfRNeb/8p+NsiFIFtM4S8oiIPmZki5gnMnwecXVU=' 'sha256-UaANRm3NJUg83RprZuIqcRwvD4SdNWEGguuQUXofL5M=' 'sha256-XVtnw168UaF2gfprY7oYXhU2gwnoAsNghwpzCXv579E=' 'sha256-fMp+AF3ucTukLoa2wI7n0Z5hRTI58LUSELeasnkRvrE=' 'sha256-g4zsHoaiZlTFxw85ShEBGHatGFHHcKZNR2bMdOsvpzE=' 'sha256-o71/hRunhFZKD9rM14479mwBpfAlTSuH6+QtvEiZiNQ=' 'sha256-tUiUMbMcgUF68GU/a+dgAdaDuCes4yqR/fTAFIO/f5U=' 'sha256-w5NnhkMHdTqDL9nHBj1zSBOPkBvf/XdmNUZ1W670LNE=' 'sha256-yWq8KYzpVj+gBNwRNhFD1fdWBXiLfgK5WAHkj7hMO/I=' 'sha256-zEX7D3VSc3Q+hUKHXt01xRd/aXPO+anewoTtTT8tqks=' ниже, подставляет build() в конце).
  # CSP_SOFT (см. SetEnvIf выше) — весь блог включая главную (PHP, _blog/router.php: route=home вставляет
  # карточки статей с inline style="margin:…" мимо build.py — lib.php:render_home(); route=index/article —
  # JSON-LD статьи меняется на лету из админки), админка (вся SPA — один большой инлайн-скрипт) и страницы
  # заказчиков (/lp/, не проверялись отдельно). /kz/ — чисто статическая, без PHP, остаётся enforced.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-3n6idvuHpScgpn9nLbP70cjHcC5/W7R1cJdbhfWXvHw=' 'sha256-5r3QhUpwYLkeKvYr5b3YUOWDxryAkVfcS7XaL5yyINY=' 'sha256-D6Edc1C05AN/e3SL1C9KYUrxrCwFcB/PY34Igck4Z7U=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-EQb2/p4Uv56vxKorR2KKQXvIBeDvLOGSDsbe9o76yTE=' 'sha256-FnTfH2386+agLICky+4R3CPW6nfBHxasDyQ1I2vxGqo=' 'sha256-J651B0aohC6ucUYprXjBhr6EizJCG7rPSkGYBwKCRPQ=' 'sha256-JAnWNJVFA23Uc3eTUV7C8uPaRsnk3sbCLz3lhpMBPnQ=' 'sha256-JCje1nHdPymhaxO3CtqCTR57lg0iaab2IzvNLNIakZ0=' 'sha256-Jr/UwlHcjeEhmCMt4wAEiK8UCUuru5P/MqAno4c06oU=' 'sha256-L52zYt8BQ5vw7EJPYZwPlkPcWUPLrYHAuLXw9i+sMb4=' 'sha256-LKGFOVif1Qw4XzXusEBkt9D1DCVtwHYRoKk9g2Me8bU=' 'sha256-MBfFgv0Qg6xep+Q8Cc0AwMIyVoeJIqz0QUjgIaA1tXU=' 'sha256-S7bBfRNeb/8p+NsiFIFtM4S8oiIPmZki5gnMnwecXVU=' 'sha256-UaANRm3NJUg83RprZuIqcRwvD4SdNWEGguuQUXofL5M=' 'sha256-XVtnw168UaF2gfprY7oYXhU2gwnoAsNghwpzCXv579E=' 'sha256-fMp+AF3ucTukLoa2wI7n0Z5hRTI58LUSELeasnkRvrE=' 'sha256-g4zsHoaiZlTFxw85ShEBGHatGFHHcKZNR2bMdOsvpzE=' 'sha256-o71/hRunhFZKD9rM14479mwBpfAlTSuH6+QtvEiZiNQ=' 'sha256-tUiUMbMcgUF68GU/a+dgAdaDuCes4yqR/fTAFIO/f5U=' 'sha256-w5NnhkMHdTqDL9nHBj1zSBOPkBvf/XdmNUZ1W670LNE=' 'sha256-yWq8KYzpVj+gBNwRNhFD1fdWBXiLfgK5WAHkj7hMO/I=' 'sha256-zEX7D3VSc3Q+hUKHXt01xRd/aXPO+anewoTtTT8tqks=' https://connect.facebook.net https://cdn.jsdelivr.net https://www.clarity.ms https://*.clarity.ms; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com https://cdn.jsdelivr.net https://*.clarity.ms https://c.bing.com; connect-src 'self' https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://e1-0850197d5e074be58352ddc860645af6.ecs.us-east-1.on.aws; frame-src 'self' https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; report-uri /api/csp-report.php" env=!CSP_SOFT
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://cdn.jsdelivr.net https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.facebook.com https://cdn.jsdelivr.net https://*.clarity.ms https://c.bing.com; connect-src 'self' https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://e1-0850197d5e074be58352ddc860645af6.ecs.us-east-1.on.aws; frame-src 'self' https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; report-uri /api/csp-report.php" env=CSP_SOFT
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>
