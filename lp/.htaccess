# Рекламные страницы правятся часто: HTML не кэшируем (иначе после правки 10 минут видна старая версия).
# Стили и скрипты кэшируются на год — ссылки на них с ?v=<хэш>, новая версия грузится сразу.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
